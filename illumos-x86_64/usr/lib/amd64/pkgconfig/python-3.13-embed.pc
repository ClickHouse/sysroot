# See: man pkg-config
prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib/amd64
includedir=/usr/include

Name: Python
Description: Embed Python into an application
Requires:
Version: 3.13
Libs.private: -lsocket -lnsl -lintl -ldl -lsendfile 
Libs: -L${libdir} -lpython3.13
Cflags: -I${includedir}/python3.13
