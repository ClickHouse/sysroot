prefix=/usr
exec_prefix=${prefix}
includedir=/usr/include
libdir=/usr/lib/amd64

Name: netsnmp-agent (Net-SNMP)
Description: SNMP (Simple Network Management Protocol) sub-agent SDK.
URL: http://www.net-snmp.org
Version: 5.9.4.pre2
Cflags: -I${includedir}
Libs: -L${libdir} -lnetsnmpmibs -lnetsnmpagent -lnetsnmp
Libs.private: -L/usr/ssl/lib  -m64 -lm -ladm  -lpcre -lpcre -lkvm   -lm   -lkstat -lsocket -lssl -L/usr -lssl -lcrypto -lnsl -lsocket -lelf 
